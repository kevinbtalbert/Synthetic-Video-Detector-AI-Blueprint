# Copy to .env for local docker-compose (never commit real keys)

# Required for bundled NIM and serverless NVCF
NGC_API_KEY=

# Deployment mode: BUNDLED (local NIM GPU app) or SERVERLESS (NVIDIA Cloud API)
NIM_DEPLOY_MODE=BUNDLED

# Serverless NVCF settings (when NIM_DEPLOY_MODE=SERVERLESS)
NVIDIA_SERVERLESS_GRPC_HOST=grpc.nvcf.nvidia.com
NVIDIA_SERVERLESS_GRPC_PORT=443
SVD_NVIDIA_FUNCTION_ID=847b6e53-0133-452d-ab85-d7acf3ace723

# Bundled NIM image (docker-compose DinD sidecar)
SVD_NIM_IMAGE=nvcr.io/nim/nvidia/synthetic-video-detector:latest

# UI port
APP_PORT=3000
