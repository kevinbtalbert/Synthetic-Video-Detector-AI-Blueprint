# syntax=docker/dockerfile:1
# Optional NVCF gRPC layer on top of the open runtime image.
# Build open image first, then: ./scripts/docker/build-svd-image.sh --serverless

ARG BASE_TAG=synthetic-video-detector:1.9
FROM ${BASE_TAG}

USER root
WORKDIR /opt/synthetic-video-detector

COPY protos ./protos
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/* \
    && uv sync --extra open --extra serverless \
    && bash protos/generate_protos.sh \
    && chown -R cdsw:cdsw /opt/synthetic-video-detector

USER cdsw

ENV ML_RUNTIME_EDITION="SyntheticVideoDetector-Serverless" \
    ML_RUNTIME_DESCRIPTION="Open runtime plus NVIDIA Cloud Functions gRPC (optional)"

LABEL com.cloudera.ml.runtime.edition=$ML_RUNTIME_EDITION \
    com.cloudera.ml.runtime.description=$ML_RUNTIME_DESCRIPTION
